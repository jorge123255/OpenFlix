    // MARK: - Landscape Full Guide

    private let guideHourWidth: CGFloat = 240
    private let guideChannelWidth: CGFloat = 120
    private let guideRowHeight: CGFloat = 72

    private var landscapeGuide: some View {
        VStack(spacing: 0) {
            landscapeDateStrip

            if viewModel.isLoading {
                Spacer()
                ProgressView().tint(.white)
                Spacer()
            } else if filteredChannels.isEmpty {
                emptyState
            } else {
                landscapeGrid
            }
        }
        .ignoresSafeArea(.all, edges: .bottom)
    }

    // MARK: - Date Strip (14 days: 2 past + today + 11 future)

    private var landscapeDateStrip: some View {
        let today = Calendar.current.startOfDay(for: Date())
        return ScrollView(.horizontal, showsIndicators: false) {
            HStack(spacing: 6) {
                Color.clear.frame(width: 44) // space for menu button

                ForEach(-2..<12, id: \.self) { offset in
                    let date = Calendar.current.date(byAdding: .day, value: offset, to: today)!
                    let isSelected = Calendar.current.isDate(date, inSameDayAs: guideDate)
                    let isToday = Calendar.current.isDateInToday(date)

                    Button {
                        guideDate = date
                        // Reset scroll offset when changing day
                        landscapeScrollOffset = .zero
                    } label: {
                        VStack(spacing: 2) {
                            Text(dayAbbrev(date))
                                .font(.system(size: 9, weight: .medium))
                                .foregroundStyle(isToday ? accentPurple : Color.gray)
                            Text(dayNum(date))
                                .font(.system(size: 13, weight: .bold))
                                .foregroundStyle(.white)
                        }
                        .padding(.horizontal, 10)
                        .padding(.vertical, 5)
                        .background(isSelected ? accentPurple : Color.white.opacity(0.1))
                        .cornerRadius(8)
                        .overlay(
                            RoundedRectangle(cornerRadius: 8)
                                .stroke(isToday && !isSelected ? accentPurple.opacity(0.5) : .clear, lineWidth: 1)
                        )
                    }
                }
            }
            .padding(.horizontal, 8)
            .padding(.vertical, 6)
        }
        .background(bgColor)
    }

    private func dayAbbrev(_ date: Date) -> String {
        let f = DateFormatter()
        f.dateFormat = "EEE"
        return f.string(from: date).uppercased()
    }

    private func dayNum(_ date: Date) -> String {
        let f = DateFormatter()
        f.dateFormat = "d"
        return f.string(from: date)
    }

    private var totalLandscapeWidth: CGFloat { guideHourWidth * 24 }
    private let landscapeHeaderHeight: CGFloat = 36

    // X position of "now" in the grid (pixels from midnight)
    private var nowXPosition: CGFloat {
        let midnight = Calendar.current.startOfDay(for: guideDate)
        return CGFloat(Date().timeIntervalSince(midnight)) * (guideHourWidth / 3600.0)
    }

    private var landscapeGrid: some View {
        GeometryReader { geo in
            VStack(spacing: 0) {
                // ── TOP ROW: corner cell (menu) + pinned time ruler ──
                HStack(spacing: 0) {
                    // Corner — contains the menu button
                    landscapeCornerMenu
                        .frame(width: guideChannelWidth, height: landscapeHeaderHeight)
                        .background(Color(white: 0.08))

                    // Time ruler — clipped viewport, slides with horizontal scroll
                    landscapeTimeRuler
                        .frame(width: totalLandscapeWidth)
                        .offset(x: -landscapeScrollOffset.x)
                        .frame(width: geo.size.width - guideChannelWidth, height: landscapeHeaderHeight, alignment: .leading)
                        .clipped()
                }
                .background(Color(white: 0.07))
                .zIndex(2)

                // ── BOTTOM ROW: pinned channel column + scrollable program grid ──
                HStack(spacing: 0) {
                    // Channel column — clipped viewport, slides with vertical scroll
                    VStack(spacing: 0) {
                        ForEach(filteredChannels) { channel in
                            landscapeChannelCell(channel)
                                .frame(width: guideChannelWidth, height: guideRowHeight)
                            Divider().background(Color.white.opacity(0.06))
                        }
                    }
                    .offset(y: -landscapeScrollOffset.y)
                    .frame(width: guideChannelWidth)
                    .frame(height: geo.size.height - landscapeHeaderHeight, alignment: .top)
                    .clipped()
                    .background(Color(white: 0.07))
                    .zIndex(1)

                    // Main program grid — scrolls both axes, auto-jumps to "now"
                    ScrollViewReader { proxy in
                        ScrollView([.horizontal, .vertical], showsIndicators: false) {
                            ZStack(alignment: .topLeading) {
                                // Offset tracker
                                GeometryReader { inner in
                                    Color.clear.preference(
                                        key: LandscapeScrollOffsetKey.self,
                                        value: CGPoint(
                                            x: -inner.frame(in: .named("landscapeGrid")).minX,
                                            y: -inner.frame(in: .named("landscapeGrid")).minY
                                        )
                                    )
                                }
                                .frame(width: 1, height: 1)

                                // Invisible anchor for "jump to now"
                                Color.clear.frame(width: 1, height: 1)
                                    .id("landscapeNow")
                                    .offset(x: max(nowXPosition - 60, 0), y: 0)

                                // Program rows
                                LazyVStack(spacing: 0) {
                                    ForEach(filteredChannels) { channel in
                                        landscapeProgramRow(channel)
                                            .frame(height: guideRowHeight)
                                        Divider().background(Color.white.opacity(0.06))
                                    }
                                }
                                .frame(width: totalLandscapeWidth)
                            }
                            .frame(width: totalLandscapeWidth)
                        }
                        .coordinateSpace(name: "landscapeGrid")
                        .onPreferenceChange(LandscapeScrollOffsetKey.self) { offset in
                            DispatchQueue.main.async { landscapeScrollOffset = offset }
                        }
                        .onAppear {
                            // Auto-scroll to current time when viewing today
                            if Calendar.current.isDateInToday(guideDate) {
                                DispatchQueue.main.asyncAfter(deadline: .now() + 0.15) {
                                    proxy.scrollTo("landscapeNow", anchor: .leading)
                                }
                            }
                        }
                        .onChange(of: guideDate) { _ in
                            // When switching to today, jump to now; otherwise go to start
                            DispatchQueue.main.asyncAfter(deadline: .now() + 0.1) {
                                if Calendar.current.isDateInToday(guideDate) {
                                    proxy.scrollTo("landscapeNow", anchor: .leading)
                                } else {
                                    proxy.scrollTo("landscapeNow", anchor: .leading)
                                }
                            }
                        }
                    }
                }
            }
        }
    }

