// MARK: - Catch Up Sheet Models

private struct CatchUpSheetProgram {
    let id: String
    let title: String
    let description: String?
    let icon: String?
    let startTime: Date
    let endTime: Date
    let streamUrl: URL?

    var timeFormatted: String {
        let formatter = DateFormatter()
        formatter.dateFormat = "h:mm a"
        return formatter.string(from: startTime)
    }

    var durationFormatted: String {
        let minutes = Int(endTime.timeIntervalSince(startTime) / 60)
        if minutes >= 60 {
            return "\(minutes / 60)h \(minutes % 60)m"
        }
        return "\(minutes) min"
    }
}

// MARK: - Catch Up Sheet ViewModel

@MainActor
private class CatchUpSheetViewModel: ObservableObject {
    private let api = OpenFlixAPI.shared
    @Published var programs: [CatchUpSheetProgram] = []
    @Published var isLoading = false

    var groupedByDate: [(String, [CatchUpSheetProgram])] {
        let grouped = Dictionary(grouping: programs) { program -> String in
            let calendar = Calendar.current
            if calendar.isDateInToday(program.startTime) { return "Today" }
            if calendar.isDateInYesterday(program.startTime) { return "Yesterday" }
            let formatter = DateFormatter()
            formatter.dateFormat = "EEEE, MMM d"
            return formatter.string(from: program.startTime)
        }
        return grouped.sorted { pair1, pair2 in
            let date1 = pair1.1.first?.startTime ?? Date.distantPast
            let date2 = pair2.1.first?.startTime ?? Date.distantPast
            return date1 > date2
        }
    }

    func loadPrograms(channelId: String) {
        isLoading = true
        Task {
            do {
                let response = try await api.getCatchupPrograms(channelId: channelId)
                let isoFormatter = ISO8601DateFormatter()
                isoFormatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
                let isoFormatterBasic = ISO8601DateFormatter()

                // Pre-build stream URLs
                var streamUrls: [String: URL] = [:]
                for dto in response.programs {
                    if let urlStr = dto.streamUrl, !urlStr.isEmpty {
                        if urlStr.hasPrefix("http"), let url = URL(string: urlStr) {
                            streamUrls[dto.id.stringValue] = url
                        } else if let url = await api.buildURL(path: urlStr) {
                            streamUrls[dto.id.stringValue] = url
                        }
                    }
                }

                programs = response.programs.compactMap { dto -> CatchUpSheetProgram? in
                    guard let start = isoFormatter.date(from: dto.startTime) ?? isoFormatterBasic.date(from: dto.startTime),
                          let end = isoFormatter.date(from: dto.endTime) ?? isoFormatterBasic.date(from: dto.endTime) else {
                        return nil
                    }

                    return CatchUpSheetProgram(
                        id: dto.id.stringValue,
                        title: dto.title,
                        description: dto.description,
                        icon: dto.icon,
                        startTime: start,
                        endTime: end,
                        streamUrl: streamUrls[dto.id.stringValue]
                    )
                }.sorted { $0.startTime > $1.startTime }
            } catch {
                print("Failed to load catch-up programs: \(error)")
            }
            isLoading = false
        }
    }
}

