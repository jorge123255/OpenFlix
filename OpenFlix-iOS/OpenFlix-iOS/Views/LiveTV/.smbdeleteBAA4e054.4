    private var landscapeTimeRuler: some View {
        let calendar = Calendar.current
        let midnight = calendar.startOfDay(for: guideDate)
        let now = Date()
        let isToday = calendar.isDateInToday(guideDate)
        let formatter = DateFormatter()
        formatter.dateFormat = "h a"

        return HStack(spacing: 0) {
            ForEach(0..<24, id: \.self) { hour in
                let slotTime = midnight.addingTimeInterval(TimeInterval(hour * 3600))
                let isCurrent = isToday && calendar.component(.hour, from: now) == hour
                Text(formatter.string(from: slotTime))
                    .font(.system(size: 11, weight: isCurrent ? .bold : .medium))
                    .foregroundStyle(isCurrent ? accentPurple : Color.gray)
                    .frame(width: guideHourWidth, alignment: .leading)
                    .padding(.leading, 8)
                    .background(isCurrent ? accentPurple.opacity(0.12) : Color.clear)
            }
        }
        .background(bgColor)
    }

