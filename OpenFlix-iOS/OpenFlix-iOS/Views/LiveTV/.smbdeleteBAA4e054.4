import SwiftUI

extension Notification.Name {
    static let switchTab = Notification.Name("switchTab")
}

// Scroll offset preference key for the landscape EPG grid
private struct LandscapeScrollOffsetKey: PreferenceKey {
    static var defaultValue: CGPoint = .zero
    static func reduce(value: inout CGPoint, nextValue: () -> CGPoint) { value = nextValue() }
}

// MARK: - Program Detail Context

struct ProgramDetailContext: Identifiable {
    var id: String { program.id }
    let program: Program
    let channel: Channel
}

// MARK: - Xfinity-Style Live TV View (Simple List)

struct XfinityLiveTVView: View {
    @StateObject private var viewModel = LiveTVViewModel()
    @State private var selectedFilter: ChannelFilter = .all
    @State private var selectedDay: DayFilter = .today
    @State private var selectedChannel: Channel?
    @State private var showFullGuide = false
    @State private var programDetailContext: ProgramDetailContext?
    @State private var recordingToast: String?
    @State private var showRecordingToast = false

    // Feature navigation
    @State private var showCatchup = false
    @State private var showOnLater = false
    @State private var showTeamPass = false
    @State private var showChannelGroups = false
    @State private var showChannelSurfing = false

    // Landscape EPG
    @Environment(\.horizontalSizeClass) private var horizontalSizeClass
    @State private var isLandscape = UIDevice.current.orientation.isLandscape
    @State private var guideDate = Date()
    @State private var landscapeScrollOffset: CGPoint = .zero

    private let dvrRepository = DVRRepository()
    
    enum ChannelFilter: String, CaseIterable {
        case all = "All channels"
        case favorites = "Favorites"
        case sports = "Sports"
        case news = "News"
        case movies = "Movies"
        case kids = "Kids"
    }
    
    enum DayFilter: String, CaseIterable {
        case today = "Today"
        case tomorrow = "Tomorrow"
    }
    
