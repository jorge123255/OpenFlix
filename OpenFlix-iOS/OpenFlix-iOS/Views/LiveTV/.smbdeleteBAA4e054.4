        }
    }

    private func landscapeProgramRow(_ channel: Channel) -> some View {
        let programs = programsForChannel(channel)
        let calendar = Calendar.current
        let midnight = calendar.startOfDay(for: guideDate)
        let gridEnd = midnight.addingTimeInterval(24 * 3600)
        let now = Date()
        let pixelsPerSecond = guideHourWidth / 3600.0
        let totalW = totalLandscapeWidth

        let visible = programs.filter { $0.endTime > midnight && $0.startTime < gridEnd }

        return ZStack(alignment: .leading) {
            // "Now" indicator line (red vertical bar at current time)
            if calendar.isDate(guideDate, inSameDayAs: now) {
                let nowX = CGFloat(now.timeIntervalSince(midnight)) * pixelsPerSecond
                Rectangle()
                    .fill(Color.red.opacity(0.8))
                    .frame(width: 2, height: guideRowHeight)
                    .offset(x: nowX)
                    .zIndex(10)
            }

            ForEach(visible) { program in
                let clampedStart = max(program.startTime, midnight)
                let clampedEnd   = min(program.endTime, gridEnd)
                let xOffset      = CGFloat(clampedStart.timeIntervalSince(midnight)) * pixelsPerSecond
                let width        = max(CGFloat(clampedEnd.timeIntervalSince(clampedStart)) * pixelsPerSecond - 2, 30)

                let isNow   = program.startTime <= now && program.endTime > now
                let isPast  = program.hasEnded
                let cellWidth = max(width, 30)

                VStack(alignment: .leading, spacing: 2) {
                    // Title
                    Text(program.title)
                        .font(.system(size: 13, weight: isNow ? .semibold : .regular))
                        .foregroundStyle(isPast ? Color.gray : Color.white)
                        .lineLimit(2)

                    // Badges (only if cell is wide enough to show them)
                    if cellWidth > 60 {
                        landscapeProgramBadges(program)
                    }

                    // Progress bar for currently-airing programs
                    if isNow {
                        GeometryReader { g in
                            ZStack(alignment: .leading) {
                                Rectangle().fill(Color.white.opacity(0.15))
                                Rectangle().fill(accentPurple).frame(width: g.size.width * program.progress)
                            }
                        }
                        .frame(height: 3)
                    }

                    // Start time
                    Text(timeLabel(program.startTime))
                        .font(.system(size: 11))
                        .foregroundStyle(isNow ? accentPurple : Color.gray)
                }
                .padding(.horizontal, 8)
                .padding(.vertical, 6)
                .frame(width: cellWidth, height: guideRowHeight - 6, alignment: .topLeading)
                .background(
                    isPast  ? cardBg.opacity(0.4) :
                    isNow   ? accentPurple.opacity(0.25) : cardBg
                )
                .cornerRadius(6)
                .overlay(
                    RoundedRectangle(cornerRadius: 6)
                        .stroke(isNow ? accentPurple.opacity(0.5) : Color.white.opacity(0.06), lineWidth: isNow ? 1 : 0.5)
                )
                .offset(x: xOffset + 1)
                .onTapGesture {
                    programDetailContext = ProgramDetailContext(program: program, channel: channel)
                }
            }
        }
        .frame(width: totalW, alignment: .leading)
        .clipped()
    }

    @ViewBuilder
    private func landscapeProgramBadges(_ program: Program) -> some View {
        let badges = epgBadges(program)
        if !badges.isEmpty {
            HStack(spacing: 3) {
                ForEach(badges.prefix(2), id: \.label) { badge in
                    Text(badge.label)
                        .font(.system(size: 9, weight: .bold))
                        .foregroundStyle(.white)
                        .padding(.horizontal, 4)
                        .padding(.vertical, 1)
                        .background(badge.color)
                        .cornerRadius(3)
                }
            }
        }
    }

    private struct EPGBadge { let label: String; let color: Color }

    private func epgBadges(_ program: Program) -> [EPGBadge] {
        var result: [EPGBadge] = []
        if program.isLive      { result.append(.init(label: "LIVE",    color: .red)) }
        if program.isNew       { result.append(.init(label: "NEW",     color: Color(red: 0.1, green: 0.7, blue: 0.3))) }
        if program.isPremiere  { result.append(.init(label: "PREM",    color: .purple)) }
        if program.isFinale    { result.append(.init(label: "FINALE",  color: .orange)) }
        if program.isSports    { result.append(.init(label: "SPORTS",  color: Color(red: 0.1, green: 0.5, blue: 0.9))) }
        if program.category?.lowercased().contains("news") == true {
                               result.append(.init(label: "NEWS",     color: Color(red: 0.5, green: 0.5, blue: 0.6))) }
        if program.hasEnded    { result.append(.init(label: "PAST",    color: Color.gray.opacity(0.8))) }
        return result
    }

    private func timeLabel(_ date: Date) -> String {
        let formatter = DateFormatter()
        formatter.dateFormat = "h:mm a"
        return formatter.string(from: date)
    }

