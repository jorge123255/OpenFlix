                Button {
                    showFullGuide = true
                } label: {
                    Image(systemName: "calendar")
                        .foregroundColor(.white)
                }
            }
        }
        .sheet(isPresented: $showFullGuide) {
            EPGGuideView(viewModel: viewModel)
        }
        .sheet(item: $programDetailContext) { context in
            ModernProgramDetailSheet(
                program: context.program,
                channel: context.channel,
                onPlay: {
                    programDetailContext = nil
                    selectedChannel = context.channel
                },
                onRecord: {
                    programDetailContext = nil
                    recordProgram(context.program, channel: context.channel)
                },
                onCreatePass: { options in
