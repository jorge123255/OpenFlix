import Foundation
import SwiftUI
import Network
import Darwin

/// Connection mode for the auth flow
enum ConnectionMode: String {
    /// Initial mode selection (At Home / Away from Home)
    case selection
    /// At home - auto-discover servers on local network
    case atHome
    /// Away from home - manual server URL entry
    case awayFromHome
}

@MainActor
class AuthViewModel: ObservableObject {
    private let authRepository = AuthRepository()

    @Published var isAuthenticated = false
    @Published var isLoading = false
    @Published var error: String?
    @Published var currentUser: User?
    @Published var currentProfile: Profile?
    @Published var profiles: [Profile] = []

    // Connection mode — start in .atHome so discovery screen shows immediately
    @Published var connectionMode: ConnectionMode = .atHome

    // Server discovery
    @Published var discoveredServers: [DiscoveredServer] = []
    @Published var isDiscovering = false
    @Published var discoveryProgress: String?
    @Published var autoConnected = false
    @Published var isLocalAccessMode = false

    // Cloud discovery URL — enables away-from-home reconnection via discover.openflix.app
    private let cloudRegistryURL: String? = "https://discover.openflix.io"

    private let connectionTimeout: TimeInterval = 1.5

    // MARK: - Initialization

    func initialize() async {
        // Check if we have a saved server URL
        if let savedURL = UserDefaults.standard.serverURL {
            // Try to reconnect silently
            connectionMode = .atHome
            discoveryProgress = "Reconnecting to your server..."
            isDiscovering = true

            if await testServerConnection(savedURL) {
                await autoConnectToServer(DiscoveredServer(
                    name: "OpenFlix Server",
                    version: "unknown",
                    machineId: UserDefaults.standard.lastMachineId ?? savedURL.host ?? "server",
                    host: savedURL.host ?? "",
                    port: savedURL.port ?? 32400
                ))
                return
            }

            // Saved URL failed - try cloud discovery with saved machineId
            if let machineId = UserDefaults.standard.lastMachineId {
                discoveryProgress = "Checking cloud for server..."
                if let server = await discoverViaCloud(machineId: machineId) {
                    print("DISCOVERY: Found server via cloud machineId reconnect")
                    await selectServer(server)
                    isDiscovering = false
                    return
                }
            }

            // All reconnection failed, fall back to discovery
            isDiscovering = false
        }

        // No saved URL (fresh install) — skip mode selection, go straight to discovery
        connectionMode = .atHome
        Task { await discoverServers() }
    }

    // MARK: - Connection Mode Actions

    func selectAtHome() {
        connectionMode = .atHome
        Task {
            await discoverServers()
        }
    }

    func selectAwayFromHome() {
        connectionMode = .awayFromHome
    }

    func goBackToModeSelection() {
        connectionMode = .selection
        discoveredServers = []
        isDiscovering = false
        discoveryProgress = nil
        error = nil
    }

    // MARK: - Server Discovery (parallel UDP + Bonjour + Subnet Scan)

    func discoverServers() async {
        isDiscovering = true
        discoveredServers = []
        error = nil
        discoveryProgress = "Searching for server..."

        defer {
            isDiscovering = false
        }

        // Run UDP, Bonjour, and subnet scan all in parallel — first result wins
        let server: DiscoveredServer? = await withTaskGroup(of: DiscoveredServer?.self) { group in
            group.addTask { await self.discoverViaUDP(timeout: 5.0).first }
            group.addTask { await self.discoverViaBonjour(timeout: 8.0).first }
            group.addTask { await self.discoverViaSubnetScan() }

            for await result in group {
                if let found = result {
                    group.cancelAll()
                    return found
                }
            }
            return nil
        }

        if let found = server {
            discoveredServers.append(found)
            print("DISCOVERY: Found server: \(found.name) at \(found.host):\(found.port)")
            await selectServer(found)
            return
        }

        // Fallback: cloud registry with saved machineId
        if let machineId = UserDefaults.standard.lastMachineId {
            discoveryProgress = "Checking cloud registry..."
            if let cloudServer = await discoverViaCloud(machineId: machineId) {
                discoveredServers.append(cloudServer)
                print("DISCOVERY: Found server via cloud: \(cloudServer.name) at \(cloudServer.host):\(cloudServer.port)")
                await selectServer(cloudServer)
                return
            }
        }

        discoveryProgress = nil
        error = "No servers found on your network. Make sure your OpenFlix server is running."
    }

    // MARK: - Subnet Scan Discovery

    /// Scans all IPs on the device's local subnet concurrently, probing port 32400.
    private func discoverViaSubnetScan() async -> DiscoveredServer? {
        guard let localIP = getLocalIPAddress(), let subnet = subnetPrefix(from: localIP) else {
            print("SUBNET SCAN: Could not determine local IP")
            return nil
        }
        print("SUBNET SCAN: Scanning \(subnet).1-254 ...")

        return await withTaskGroup(of: DiscoveredServer?.self) { group in
            for i in 1...254 {
                let host = "\(subnet).\(i)"
                group.addTask {
                    await self.probeServer(host: host, port: 32400)
                }
            }

            for await result in group {
                if let server = result {
                    group.cancelAll()
                    return server
                }
            }
            return nil
        }
    }

    private func getLocalIPAddress() -> String? {
        var address: String?
        var ifaddr: UnsafeMutablePointer<ifaddrs>?
        guard getifaddrs(&ifaddr) == 0, let firstAddr = ifaddr else { return nil }
        defer { freeifaddrs(ifaddr) }

        var ptr = firstAddr
        while ptr.pointee.ifa_next != nil {
            let interface = ptr.pointee
            let family = interface.ifa_addr.pointee.sa_family
            if family == UInt8(AF_INET) {
                let name = String(cString: interface.ifa_name)
                if name == "en0" {
                    var hostname = [CChar](repeating: 0, count: Int(NI_MAXHOST))
                    getnameinfo(interface.ifa_addr, socklen_t(interface.ifa_addr.pointee.sa_len),
                                &hostname, socklen_t(hostname.count), nil, 0, NI_NUMERICHOST)
                    address = String(cString: hostname)
                }
            }
            ptr = ptr.pointee.ifa_next!
        }
        return address
    }

    private func subnetPrefix(from ip: String) -> String? {
        let parts = ip.split(separator: ".")
        guard parts.count == 4 else { return nil }
        return parts.prefix(3).joined(separator: ".")
    }

    // MARK: - UDP Discovery

    /// Sends OPENFLIX_DISCOVER broadcast and listens for server responses.
    private func discoverViaUDP(timeout: TimeInterval) async -> [DiscoveredServer] {
        await withCheckedContinuation { continuation in
            let discovery = UDPServerDiscovery(timeout: timeout) { servers in
                continuation.resume(returning: servers)
            }
            discovery.start()
        }
    }

    // MARK: - Bonjour/mDNS Discovery

    private func discoverViaBonjour(timeout: TimeInterval) async -> [DiscoveredServer] {
        await withCheckedContinuation { continuation in
            let browser = BonjourServerBrowser(timeout: timeout) { servers in
                continuation.resume(returning: servers)
            }
            browser.start()
        }
    }

    // MARK: - Cloud Discovery

    /// Look up a server by its machineId in the cloud registry (for reconnection).
    private func discoverViaCloud(machineId: String) async -> DiscoveredServer? {
        guard let baseURL = cloudRegistryURL,
              let url = URL(string: "\(baseURL)/servers?machineId=\(machineId)") else {
            return nil
        }

        var request = URLRequest(url: url)
        request.timeoutInterval = 5

        do {
            let (data, response) = try await URLSession.shared.data(for: request)
            guard let httpResponse = response as? HTTPURLResponse, httpResponse.statusCode == 200 else {
                return nil
            }

            guard let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else {
                return nil
            }

            let name = json["name"] as? String ?? "OpenFlix Server"
            let host = json["publicIp"] as? String ?? json["host"] as? String ?? ""
            let port = json["port"] as? Int ?? 32400
            let version = json["version"] as? String ?? "unknown"

            guard !host.isEmpty else { return nil }

            // Verify this server is actually reachable
            let server = DiscoveredServer(name: name, version: version, machineId: machineId, host: host, port: port)
            if await testServerConnection(server.url) {
                return server
            }
        } catch {
            print("DISCOVERY: Cloud lookup failed: \(error)")
        }

        return nil
    }

    /// Look up a server by claim token in the cloud registry (first-time pairing).
    func discoverViaCloud(claimToken: String) async -> DiscoveredServer? {
        guard let baseURL = cloudRegistryURL,
              let url = URL(string: "\(baseURL)/servers?token=\(claimToken)") else {
            return nil
        }

        var request = URLRequest(url: url)
        request.timeoutInterval = 5

        do {
            let (data, response) = try await URLSession.shared.data(for: request)
            guard let httpResponse = response as? HTTPURLResponse, httpResponse.statusCode == 200 else {
                return nil
            }

            guard let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else {
                return nil
            }

            let name = json["name"] as? String ?? "OpenFlix Server"
            let host = json["publicIp"] as? String ?? json["host"] as? String ?? ""
            let port = json["port"] as? Int ?? 32400
            let version = json["version"] as? String ?? "unknown"
            let machineId = json["machineId"] as? String ?? ""

            guard !host.isEmpty else { return nil }

            let server = DiscoveredServer(name: name, version: version, machineId: machineId, host: host, port: port)
            if await testServerConnection(server.url) {
                return server
            }
        } catch {
            print("DISCOVERY: Cloud claim lookup failed: \(error)")
        }

        return nil
    }

    // MARK: - Server Validation

    private func probeServer(host: String, port: Int) async -> DiscoveredServer? {
        guard let url = URL(string: "http://\(host):\(port)/identity") else { return nil }

        var request = URLRequest(url: url)
        request.timeoutInterval = connectionTimeout

        do {
            let (data, response) = try await URLSession.shared.data(for: request)

            guard let httpResponse = response as? HTTPURLResponse,
                  httpResponse.statusCode == 200 else {
                return nil
            }

            // Parse identity response - MUST have MediaContainer with machineIdentifier
            guard let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else {
                return nil  // Not JSON = not our server
            }

            let container = json["MediaContainer"] as? [String: Any] ?? json

            // Require machineIdentifier - this proves it's an OpenFlix/Plex-compatible server
            guard let machineId = container["machineIdentifier"] as? String, !machineId.isEmpty else {
                return nil  // No machineIdentifier = not our server
            }

            let name = container["friendlyName"] as? String
                ?? container["name"] as? String
                ?? "OpenFlix Server"
            let version = container["version"] as? String ?? "unknown"

            return DiscoveredServer(
                name: name,
                version: version,
                machineId: machineId,
                host: host,
                port: port
            )
        } catch {
            return nil
        }
    }

    func testServerConnection(_ url: URL) async -> Bool {
        // Try /identity - validate it's actually an OpenFlix server
        var request = URLRequest(url: url.appendingPathComponent("identity"))
        request.timeoutInterval = 3

        do {
            let (data, response) = try await URLSession.shared.data(for: request)
            if let httpResponse = response as? HTTPURLResponse, httpResponse.statusCode == 200,
               let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any] {
                let container = json["MediaContainer"] as? [String: Any] ?? json
                if let machineId = container["machineIdentifier"] as? String, !machineId.isEmpty {
                    print("DISCOVERY: Validated server at \(url) - machineId: \(machineId)")
                    // Save machineId for cloud reconnection
                    UserDefaults.standard.lastMachineId = machineId
                    return true
                }
            }
        } catch {}

        // Fallback: try /api/status
        var statusRequest = URLRequest(url: url.appendingPathComponent("api/status"))
        statusRequest.timeoutInterval = 3

        do {
            let (data, response) = try await URLSession.shared.data(for: statusRequest)
            if let httpResponse = response as? HTTPURLResponse, httpResponse.statusCode == 200,
               let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
               let server = json["server"] as? [String: Any],
               let machineId = server["machineIdentifier"] as? String, !machineId.isEmpty {
                print("DISCOVERY: Validated server via /api/status at \(url)")
                UserDefaults.standard.lastMachineId = machineId
                return true
            }
        } catch {}

        return false
    }

    // MARK: - Server Connection

    private func autoConnectToServer(_ server: DiscoveredServer) async {
        isLoading = true
        defer { isLoading = false }

        do {
            // Configure API with discovered server
            await OpenFlixAPI.shared.configure(serverURL: server.url, token: nil)
            UserDefaults.standard.serverURL = server.url
            UserDefaults.standard.lastMachineId = server.machineId

            // Enable local access mode - no login required
            isLocalAccessMode = true
            autoConnected = true
            isAuthenticated = true

            // Load profiles - retry once if local network permission hasn't been granted yet
            // (UDP discovery can trigger the permission dialog, but HTTP requests may race ahead)
            do {
                try await loadProfiles()
            } catch {
                print("First profile load failed (likely local network permission pending), retrying in 2s...")
                try await Task.sleep(nanoseconds: 2_000_000_000)
                try await loadProfiles()
            }

            // Auto-select first profile if only one exists (single user mode)
            if profiles.count == 1, let profile = profiles.first {
                currentProfile = profile
                UserDefaults.standard.currentProfileUUID = profile.uuid
                print("Auto-selected single profile: \(profile.name)")
            }

            print("Auto-connected to local server: \(server.name) at \(server.url)")
        } catch {
            print("Failed to auto-connect after retry: \(error)")
            // Fall back to manual login
            isLocalAccessMode = false
            autoConnected = false
        }
    }

    // MARK: - Invite Accept

    /// Resolves an invite: finds the server via cloud registry, validates the invite,
    /// and returns the server info so the UI can show a registration form.
    func resolveInvite(machineId: String, token: String) async -> (server: DiscoveredServer, serverName: String)? {
        guard let baseURL = cloudRegistryURL,
              let url = URL(string: "\(baseURL)/servers?machineId=\(machineId)") else { return nil }

        var request = URLRequest(url: url)
        request.timeoutInterval = 5
        do {
            let (data, response) = try await URLSession.shared.data(for: request)
            guard let http = response as? HTTPURLResponse, http.statusCode == 200,
                  let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
                  let host = json["publicIp"] as? String ?? json["host"] as? String,
                  !host.isEmpty else { return nil }
            let port = json["port"] as? Int ?? 32400
            let name = json["name"] as? String ?? "OpenFlix Server"
            let server = DiscoveredServer(name: name, version: "unknown", machineId: machineId, host: host, port: port)
            return (server, name)
        } catch { return nil }
    }

    /// Accepts an invite: registers a new account on the home server and auto-connects.
    func acceptInvite(server: DiscoveredServer, token: String, username: String, email: String, password: String) async {
        isLoading = true
        error = nil
        defer { isLoading = false }

        struct AcceptBody: Encodable {
            let username: String
            let email: String
            let password: String
        }
        struct AcceptResponse: Decodable {
            let authToken: String
            let machineId: String
        }

        guard let url = server.url.appendingPathComponent("api/invite/\(token)/accept") as URL?,
              let body = try? JSONEncoder().encode(AcceptBody(username: username, email: email, password: password)) else {
            self.error = "Invalid invite"
            return
        }

        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.httpBody = body
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        request.timeoutInterval = 10

        do {
            let (data, response) = try await URLSession.shared.data(for: request)
            guard let http = response as? HTTPURLResponse, http.statusCode == 201,
                  let resp = try? JSONDecoder().decode(AcceptResponse.self, from: data) else {
                self.error = "Failed to accept invite. It may have expired."
                return
            }
            // Save server + token, mark authenticated
            await OpenFlixAPI.shared.configure(serverURL: server.url, token: resp.authToken)
            UserDefaults.standard.serverURL = server.url
            UserDefaults.standard.lastMachineId = server.machineId
            isAuthenticated = true
            isLocalAccessMode = false
            ensureDeviceRegistered()
            try? await loadProfiles()
        } catch {
            self.error = "Could not connect to server"
        }
    }

    func connectToServerURL(_ urlString: String) async -> Bool {
        var cleanURL = urlString.trimmingCharacters(in: .whitespacesAndNewlines)
        if !cleanURL.hasPrefix("http") {
            cleanURL = "http://\(cleanURL)"
        }

        guard let url = URL(string: cleanURL) else {
            error = "Invalid server URL"
            return false
        }

        isLoading = true
        error = nil
        defer { isLoading = false }

        let success = await testServerConnection(url)

        if success {
            UserDefaults.standard.serverURL = url
            await OpenFlixAPI.shared.configure(serverURL: url, token: nil)
            return true
        } else {
            error = "Could not connect to server at \(cleanURL)"
            return false
        }
    }

    // MARK: - Auth State

    func checkAuthStatus() async {
        isLoading = true
        defer { isLoading = false }

        // If we're in local access mode, we're authenticated
        if isLocalAccessMode {
            isAuthenticated = true
            try? await loadProfiles()
            ensureDeviceRegistered()
            return
        }

        let hasValidToken = await authRepository.checkAuthStatus()
        isAuthenticated = hasValidToken

        if isAuthenticated {
            currentUser = authRepository.currentUser
            try? await loadProfiles()
            ensureDeviceRegistered()
        }
    }

    // MARK: - Login (for remote/away access)

    func login(serverURL: URL, username: String, password: String, rememberMe: Bool) async {
        isLoading = true
        error = nil
        defer { isLoading = false }

        do {
            // Configure API with server URL
            await OpenFlixAPI.shared.configure(serverURL: serverURL, token: nil)

            // Save server URL
            UserDefaults.standard.serverURL = serverURL
            if rememberMe {
                UserDefaults.standard.lastUsername = username
                UserDefaults.standard.rememberMe = true
            }

            // Perform login
            let user = try await authRepository.login(username: username, password: password)
            currentUser = user
            isAuthenticated = true
            isLocalAccessMode = false

            // Register device (fire-and-forget)
            ensureDeviceRegistered()

            // Load profiles
            try await loadProfiles()

        } catch let networkError as NetworkError {
            error = networkError.errorDescription
        } catch {
            self.error = error.localizedDescription
        }
    }

    // MARK: - Register

    func register(serverURL: URL, name: String, email: String, password: String) async {
        isLoading = true
        error = nil
        defer { isLoading = false }

        do {
            await OpenFlixAPI.shared.configure(serverURL: serverURL, token: nil)
            UserDefaults.standard.serverURL = serverURL

            let user = try await authRepository.register(name: name, email: email, password: password)
            currentUser = user
            isAuthenticated = true

            // Register device (fire-and-forget)
            ensureDeviceRegistered()

            try await loadProfiles()

        } catch let networkError as NetworkError {
            error = networkError.errorDescription
        } catch {
            self.error = error.localizedDescription
        }
    }

    // MARK: - Logout

    func logout() async {
        await authRepository.logout()
        isAuthenticated = false
        isLocalAccessMode = false
        autoConnected = false
        currentUser = nil
        currentProfile = nil
        profiles = []
        connectionMode = .selection
    }

    // MARK: - Device Registration

    /// Ensures this device is registered with the server (checks first, registers if needed).
    private func ensureDeviceRegistered() {
        Task {
            await OpenFlixAPI.shared.ensureDeviceRegistered()
        }
    }

    // MARK: - Profiles

    func loadProfiles() async throws {
        try await authRepository.loadProfiles()
        profiles = authRepository.profiles
        currentProfile = authRepository.currentProfile
    }

    func selectProfile(_ profile: Profile, pin: String? = nil) async {
        isLoading = true
        error = nil
        defer { isLoading = false }

        do {
            try await authRepository.switchProfile(profile, pin: pin)
            currentProfile = profile
        } catch let networkError as NetworkError {
            error = networkError.errorDescription
        } catch {
            self.error = error.localizedDescription
        }
    }

    func clearProfile() {
        currentProfile = nil
        UserDefaults.standard.currentProfileUUID = nil
    }

    // MARK: - Manual Server Selection

    func selectServer(_ server: DiscoveredServer) async {
        await autoConnectToServer(server)
    }

    // MARK: - Legacy compatibility

    func discoverAndAutoConnect() async {
        await discoverServers()
    }
}

// MARK: - Discovered Server Model

struct DiscoveredServer: Identifiable {
    let name: String
    let version: String
    let machineId: String
    let host: String
    let port: Int

    var id: String { machineId }

    var url: URL {
        URL(string: "http://\(host):\(port)")!
    }
}

// MARK: - UserDefaults Extension for machineId

extension UserDefaults {
    var lastMachineId: String? {
        get { string(forKey: "openflix_last_machine_id") }
        set { set(newValue, forKey: "openflix_last_machine_id") }
    }
}

// MARK: - UDP Server Discovery

/// Discovers OpenFlix servers on the local network using UDP broadcast.
/// Sends "OPENFLIX_DISCOVER" to 255.255.255.255:32412 and listens for JSON responses.
/// Also passively listens on port 32414 for server broadcast announcements.
class UDPServerDiscovery {
    private let timeout: TimeInterval
    private let completion: ([DiscoveredServer]) -> Void
    private var servers: [DiscoveredServer] = []
    private var completed = false
    private var activeConnection: NWConnection?
    private var passiveListener: NWListener?

    private let discoveryPort: UInt16 = 32412
    private let broadcastPort: UInt16 = 32414
    private let discoveryMagic = "OPENFLIX_DISCOVER"
    private let responseMagic = "OPENFLIX_SERVER"

    init(timeout: TimeInterval, completion: @escaping ([DiscoveredServer]) -> Void) {
        self.timeout = timeout
        self.completion = completion
    }

    private func finish() {
        guard !completed else { return }
        completed = true
        activeConnection?.cancel()
        passiveListener?.cancel()
        completion(servers)
    }

    func start() {
        // Start passive listener on broadcast port 32414
        startPassiveListener()

        // Send active discovery broadcast to port 32412
        sendDiscoveryBroadcast()

        // Timeout
        DispatchQueue.main.asyncAfter(deadline: .now() + timeout) { [weak self] in
            self?.finish()
        }
    }

    /// Send "OPENFLIX_DISCOVER" as a UDP broadcast to 255.255.255.255:32412
    private func sendDiscoveryBroadcast() {
        let host = NWEndpoint.Host("255.255.255.255")
        let port = NWEndpoint.Port(rawValue: discoveryPort)!

        let params = NWParameters.udp
        params.allowLocalEndpointReuse = true
        // Enable broadcast
        params.requiredInterfaceType = .wifi

        let connection = NWConnection(host: host, port: port, using: params)
        self.activeConnection = connection

        connection.stateUpdateHandler = { [weak self] state in
            guard let self = self else { return }
            switch state {
            case .ready:
                // Send the discovery magic string
                let data = self.discoveryMagic.data(using: .utf8)!
                connection.send(content: data, completion: .contentProcessed { error in
                    if let error = error {
                        print("UDP DISCOVERY: Send error: \(error)")
                    } else {
                        print("UDP DISCOVERY: Sent broadcast to 255.255.255.255:\(self.discoveryPort)")
                    }
                })
                // Start receiving responses
                self.receiveResponse(on: connection)
            case .failed(let error):
                print("UDP DISCOVERY: Active connection failed: \(error)")
            default:
                break
            }
        }

        connection.start(queue: .global())
    }

    /// Listen for responses on the active connection
    private func receiveResponse(on connection: NWConnection) {
        connection.receiveMessage { [weak self] content, _, _, error in
            guard let self = self, !self.completed else { return }

            if let data = content, let server = self.parseDiscoveryResponse(data) {
                DispatchQueue.main.async {
                    if !self.servers.contains(where: { $0.host == server.host && $0.port == server.port }) {
                        self.servers.append(server)
                        print("UDP DISCOVERY: Found server via active: \(server.name) at \(server.host):\(server.port)")
                        // Auto-finish on first server found
                        self.finish()
                    }
                }
            }

            if error == nil && !self.completed {
                // Keep receiving
                self.receiveResponse(on: connection)
            }
        }
    }

    /// Listen on port 32414 for passive server broadcast packets
    private func startPassiveListener() {
        let params = NWParameters.udp
        params.allowLocalEndpointReuse = true

        do {
            let listener = try NWListener(using: params, on: NWEndpoint.Port(rawValue: broadcastPort)!)
            self.passiveListener = listener

            listener.newConnectionHandler = { [weak self] connection in
                guard let self = self, !self.completed else { return }
                connection.start(queue: .global())
                connection.receiveMessage { content, _, _, _ in
                    if let data = content, let server = self.parseDiscoveryResponse(data) {
                        DispatchQueue.main.async {
                            if !self.servers.contains(where: { $0.host == server.host && $0.port == server.port }) {
                                self.servers.append(server)
                                print("UDP DISCOVERY: Found server via passive broadcast: \(server.name)")
                                self.finish()
                            }
                        }
                    }
                    connection.cancel()
                }
            }

            listener.stateUpdateHandler = { state in
                switch state {
                case .ready:
                    print("UDP DISCOVERY: Passive listener ready on port \(self.broadcastPort)")
                case .failed(let error):
                    print("UDP DISCOVERY: Passive listener failed: \(error)")
                default:
                    break
                }
            }

            listener.start(queue: .global())
        } catch {
            print("UDP DISCOVERY: Failed to create passive listener: \(error)")
        }
    }

    /// Parse a JSON discovery response from the server.
    /// Expected format: {"magic": "OPENFLIX_SERVER", "server": {"name": ..., "machineId": ..., "host": ..., "port": ..., "localAddresses": [...]}}
    private func parseDiscoveryResponse(_ data: Data) -> DiscoveredServer? {
        guard let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else {
            return nil
        }

        // Check magic
        guard let magic = json["magic"] as? String, magic == responseMagic else {
            return nil
        }

        guard let serverInfo = json["server"] as? [String: Any] else {
            return nil
        }

        let name = serverInfo["name"] as? String ?? "OpenFlix Server"
        let machineId = serverInfo["machineId"] as? String ?? ""
        let host = serverInfo["host"] as? String ?? ""
        let port = serverInfo["port"] as? Int ?? 32400
        let version = serverInfo["version"] as? String ?? "unknown"

        // Try local addresses first - prefer addresses that look like they're on same subnet
        var bestHost = host
        if let localAddresses = serverInfo["localAddresses"] as? [String], !localAddresses.isEmpty {
            // Use the first local address as the most likely reachable one
            bestHost = localAddresses.first ?? host
        }

        guard !bestHost.isEmpty && !machineId.isEmpty else { return nil }

        return DiscoveredServer(
            name: name,
            version: version,
            machineId: machineId,
            host: bestHost,
            port: port
        )
    }
}

// MARK: - Bonjour Server Browser

/// Uses NWBrowser to discover OpenFlix servers via mDNS (_openflix._tcp)
class BonjourServerBrowser {
    private var browser: NWBrowser?
    private let timeout: TimeInterval
    private let completion: ([DiscoveredServer]) -> Void
    private var servers: [DiscoveredServer] = []
    private var completed = false

    init(timeout: TimeInterval, completion: @escaping ([DiscoveredServer]) -> Void) {
        self.timeout = timeout
        self.completion = completion
    }

    private func finish() {
        guard !completed else { return }
        completed = true
        browser?.cancel()
        completion(servers)
    }

    func start() {
        let params = NWParameters()
        params.includePeerToPeer = true

        browser = NWBrowser(for: .bonjour(type: "_openflix._tcp", domain: "local."), using: params)

        browser?.browseResultsChangedHandler = { [weak self] results, _ in
            guard let self = self, !self.completed else { return }

            for result in results {
                if case .service(let name, _, let domain, _) = result.endpoint {
                    print("BONJOUR: Found service: \(name) in \(domain)")
                    self.resolveService(result: result, name: name)
                }
            }
        }

        browser?.stateUpdateHandler = { [weak self] state in
            guard let self = self else { return }
            print("BONJOUR: Browser state: \(state)")
            switch state {
            case .failed(_):
                // Browser failed (e.g. no permission) - complete immediately with empty results
                print("BONJOUR: Browser failed, falling back to other discovery methods")
                self.finish()
            case .cancelled:
                self.finish()
            default:
                break
            }
        }

        browser?.start(queue: .main)

        // Timeout - return whatever we found
        DispatchQueue.main.asyncAfter(deadline: .now() + timeout) { [weak self] in
            self?.finish()
        }
    }

    private func resolveService(result: NWBrowser.Result, name: String) {
        let connection = NWConnection(to: result.endpoint, using: .tcp)
        connection.stateUpdateHandler = { [weak self] state in
            guard let self = self else { return }
            switch state {
            case .ready:
                if let path = connection.currentPath,
                   let endpoint = path.remoteEndpoint,
                   case .hostPort(let host, let port) = endpoint {

                    let hostStr: String
                    switch host {
                    case .ipv4(let addr):
                        hostStr = "\(addr)"
                    case .ipv6(let addr):
                        hostStr = "\(addr)"
                    case .name(let hostname, _):
                        hostStr = hostname
                    @unknown default:
                        hostStr = "\(host)"
                    }

                    let portInt = Int(port.rawValue)
                    print("BONJOUR: Resolved \(name) -> \(hostStr):\(portInt)")

                    let server = DiscoveredServer(
                        name: name,
                        version: "unknown",
                        machineId: "\(hostStr):\(portInt)",
                        host: hostStr,
                        port: portInt
                    )

                    DispatchQueue.main.async {
                        if !self.servers.contains(where: { $0.host == server.host && $0.port == server.port }) {
                            self.servers.append(server)
                        }
                        // Always finish when we resolve a service — even if browser timed out
                        self.completed = false
                        self.finish()
                    }
                }
                connection.cancel()
            case .failed(_), .cancelled:
                connection.cancel()
            default:
                break
            }
        }
        // Give TCP resolution 8 seconds regardless of browser timeout
        connection.start(queue: .global())
        DispatchQueue.global().asyncAfter(deadline: .now() + 8) {
            connection.cancel()
        }
    }
}
